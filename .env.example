# Токен бота «Бюро находок» из MAX для бизнеса (business.max.ru → Чат-боты → ⋮ → Настройки)
BOT_TOKEN=

# Публичный адрес, где запущен контейнер — он вписывается:
#  1) в настройки бота в «MAX для бизнеса» как URL мини-приложения;
#  2) в кнопки «Открыть мини-приложение» внутри чата.
# Для теста на своём ПК достаточно локального; для кнопки в MAX нужен HTTPS-адрес.
WEBAPP_PUBLIC_URL=http://localhost:8000

# Опционально:
# MAX_API_URL=https://platform-api2.max.ru
# POLL_TIMEOUT=30
# LIST_PAGE_SIZE=10
# TZ=Europe/Moscow
# TLS_NO_VERIFY=0
